IO_LOC "clk_50m" V22;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// FSR analog mux controls: J14-13/14/15/16/17. AO uses ADCV on J11,
// through the mandatory external divider; it is NOT a digital GPIO input.

// WAX digital pressure UART, preserved from the user's J14-39/40 handoff.
IO_LOC "WAX_RX" R14;
IO_PORT "WAX_RX" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "WAX_TX" P14;
IO_PORT "WAX_TX" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "enc_a_n[0]" Y22;
IO_PORT "enc_a_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b_n[0]" Y21;
IO_PORT "enc_b_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_a_n[1]" AB22;
IO_PORT "enc_a_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b_n[1]" AB21;
IO_PORT "enc_b_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_a_n[2]" AA21;
IO_PORT "enc_a_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b_n[2]" AA20;
IO_PORT "enc_b_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_a_n[3]" Y19;
IO_PORT "enc_a_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b_n[3]" Y18;
IO_PORT "enc_b_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_a_n[4]" R16;
IO_PORT "enc_a_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b_n[4]" P15;
IO_PORT "enc_b_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_sw_n" AA18;
IO_PORT "enc_sw_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Added AD7606 SPI: CS moved to J14-1/R19; J14-33/AA18 stays encoder switch.
IO_LOC "AD7606_DOUTA" R18;
IO_PORT "AD7606_DOUTA" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "AD7606_BUSY" U18;
IO_PORT "AD7606_BUSY" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "AD7606_FRSTDATA" U17;
IO_PORT "AD7606_FRSTDATA" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
