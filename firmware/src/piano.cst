// Merged J14 laser harp / touch LCD / Bluetooth. See docs/MERGED_WIRING.md.
IO_LOC "key0_n" AA13;
IO_LOC "key1_n" AB13;
IO_PORT "key0_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "key1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "UART_RX" V14;
IO_LOC "UART_TX" U15;
IO_PORT "UART_TX" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
