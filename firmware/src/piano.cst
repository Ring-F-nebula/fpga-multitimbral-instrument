IO_PORT "AD7606_BYTE_SEL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "AD7606_RESET" V20;
IO_PORT "AD7606_RESET" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "AD7606_CONVST" U20;
IO_PORT "AD7606_CONVST" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
